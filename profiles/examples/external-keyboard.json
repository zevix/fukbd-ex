{
  "schema_version": "2.1",
  "id": "example.external-keyboard",
  "name": "External keyboard — replace the name with the measured one",
  "description": "Shows a second profile active alongside the built-in keyboard. The input-device name is a placeholder until measured.",
  "products": [
    "android_physical"
  ],
  "scope": "ime_active",
  "languages": [
    "en",
    "he"
  ],
  "default_language": "en",
  "behavior": {
    "unmatched_key": "pass_through"
  },
  "priority": 10,
  "device_match": {
    "input": {
      "source": "keyboard",
      "is_external": true,
      "name": "REPLACE_WITH_OBSERVED_INPUT_DEVICE_NAME"
    }
  },
  "bindings": [
    {
      "id": "external_lang_alt_space",
      "trigger": {
        "key_code": "KEYCODE_SPACE",
        "phase": "down",
        "modifiers": {
          "all": [
            "ALT"
          ],
          "none": [
            "CTRL",
            "META"
          ]
        }
      },
      "action": {
        "type": "language.toggle"
      },
      "consume": true
    }
  ],
  "keymap": {
    "he": {
      "normal": {
        "KEYCODE_A": "ש"
      }
    }
  }
}
